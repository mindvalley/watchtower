{
  "name": "oracle",
  "looks_for": "places that will break when someone changes one side of an unwritten agreement",
  "changes": "proposes a guard: a test that fails on a one-sided change, or a single source of truth",
  "prompt_version": "2026-11-16",
  "prompts": {
    "audit": "prompts/audit.md",
    "merge": "prompts/merge.md",
    "verify": "prompts/verify.md"
  },
  "settings": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "key_env": "ANTHROPIC_API_KEY",
    "effort": "high",
    "max_tokens": 32000,
    "max_areas": 9,
    "concurrency": 3,
    "max_turns_per_agent": 120,
    "verify_top": 40,
    "verify_batch": 10,
    "max_cost_usd": 60,
    "pull_requests": false,
    "max_pull_requests": 3,
    "prices": {
      "claude-opus-5-5": { "input": 4, "output": 20, "cache_read": 0.2, "cache_write": 5 },
      "claude-sonnet-5-5": { "input": 2, "output": 10, "cache_read": 0.2, "cache_write": 2.5 },
      "claude-haiku-5-5": { "input": 0.1, "output": 0.5, "cache_read": 0.01, "cache_write": 0.125 }
    }
  }
}
